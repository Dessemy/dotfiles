{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/logo/arch.txt",
      "color": {
        "1": "blue"
      },
      "height": 12,
      "padding": {
        "top": 2,
        "right": 5,
        "left": 3
      }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "title": "blue",
            "output": "white"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "\u001b[38;2;203;166;247m┌─────────────────────────────────────────┐\u001b[0m"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;203;166;247m│                                         │\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mOS\u001b[0m           ",
            "format": "\u001b[38;2;205;214;244m{pretty-name>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mKernel\u001b[0m       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mUptime\u001b[0m       ",
            "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mShell\u001b[0m        ",
            "format": "\u001b[38;2;205;214;244m{pretty-name>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mWM\u001b[0m           ",
            "text": "echo $XDG_CURRENT_DESKTOP",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mOS Age\u001b[0m                       ",
            "type": "disk",
            "folders": "/",
            "format": "\u001b[38;2;205;214;244m{days} days\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mRam\u001b[0m          ",
            "text": "free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mCPU\u001b[0m          ",
            "text": "lscpu | grep 'Model name' | sed -E 's/.*(i[0-9]-[0-9A-Za-z]+).*/\\1/'",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mDisk\u001b[0m         ",
            "text": "df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mPackages\u001b[0m     ",
            "format": "\u001b[38;2;205;214;244m{all>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;203;166;247m│\u001b[0m  \u001b[38;2;137;180;250mOwner\u001b[0m        ",
            "text": "echo $USER | tr '[:lower:]' '[:upper:]'",
            "format": "\u001b[38;2;205;214;244m{>22}\u001b[0m  \u001b[38;2;203;166;247m│\u001b[0m"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;203;166;247m│                                         │\u001b[0m"
        },
        {
            "type": "command",
            "key": " ",
            "shell": "/bin/bash",
            "text": "echo '\u001b[38;2;203;166;247m│\u001b[0m     \u001b[38;2;137;180;250mWE ARE LIBRE ! ── 我々は自由だ！\u001b[0m    \u001b[38;2;203;166;247m│\u001b[0m'",
            "format": "{1}"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;203;166;247m└─────────────────────────────────────────┘\u001b[0m"
        },
        "break"
    ]
}
