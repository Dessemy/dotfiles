#!/usr/bin/env bash

set -euo pipefail

STATE_FILE="/tmp/cpupower-switcher-current"

declare -A LABELS=(
    ["performance"]="Performance"
    ["balanced"]="Balanced"
    ["powersave"]="Power Saver"
)

declare -A APP_NAMES=(
    ["performance"]="CPU Performance"
    ["balanced"]="CPU Balanced"
    ["powersave"]="CPU Power Saver"
)

set_mode() {
    local mode="$1"

    sudo /usr/local/bin/cpupower-set-mode.sh "$mode"

    if ! echo "$mode" > "$STATE_FILE" 2>/dev/null; then
        notify-send -u critical "CPU Power Mode" "Failed to write state file, check permissions $STATE_FILE"
    fi
    chmod 666 "$STATE_FILE" 2>/dev/null || true
    date +%s > /tmp/cpupower-manual-override 2>/dev/null || true
    chmod 666 /tmp/cpupower-manual-override 2>/dev/null || true
    notify-send -u normal -a "${APP_NAMES[$mode]}" "CPU Power Mode" "${LABELS[$mode]}" -t 1500

    if pgrep -x waybar &>/dev/null; then
        pkill -RTMIN+8 waybar 2>/dev/null || true
    fi
}

CURRENT="performance"
if [[ -f "$STATE_FILE" ]]; then
    CURRENT=$(cat "$STATE_FILE")
fi

if [[ $# -ge 1 ]]; then
    case "$1" in
        performance|balanced|powersave)
            set_mode "$1"
            ;;
        *)
            echo "Invalid argument. Use: performance | balanced | powersave"
            exit 1
            ;;
    esac
    exit 0
fi

case "$CURRENT" in
    performance) set_mode "balanced" ;;
    balanced)    set_mode "powersave" ;;
    powersave)   set_mode "performance" ;;
    *)           set_mode "performance" ;;
esac
